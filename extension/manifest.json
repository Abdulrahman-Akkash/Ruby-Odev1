{
  "manifest_version": 3,
  "name": "Sözleşme Radarı",
  "short_name": "Sözleşme Radarı",
  "version": "0.1.0",
  "description": "Kullanım koşulları, gizlilik politikası ve abonelik şartlarındaki riskli maddeleri birebir alıntılarla raporlar. Hukuki tavsiye değildir.",
  "minimum_chrome_version": "120",
  "action": { "default_title": "Sözleşme Radarı", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "ui/sidepanel.html" },
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content/detector.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
